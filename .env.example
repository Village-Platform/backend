# Copy to .env (git-ignored) and adjust. Production values live in the k8s secret `village-env`
# and in deploy/k8s/config.yaml, never in this file. See deploy/k8s/README.md.

# --- Database (docker-compose.yml publishes PostgreSQL on host port 5434) ---
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Seeds: the super admin created by db/seeds.rb. Phone is stored digits and "+" only. ---
SUPER_ADMIN_PHONE=01000000000
SUPER_ADMIN_PASSWORD=change-me-please

# --- HTTP ---
# Comma-separated origins for the CORS initializer. "*" is fine for the native app.
CORS_ORIGINS=*

# --- Background jobs (Solid Queue) ---
# 1 = run jobs inside `bin/rails s`. Otherwise run `bin/jobs` beside the server.
SOLID_QUEUE_IN_PUMA=1

# --- API auth ---
# 1 = every /api/v1 call needs a user or guest token (POST /api/v1/auth/guest). Keep 0 until the
# Android release that sends guest tokens is widely installed.
API_TOKEN_REQUIRED=0

# --- Payment destinations shown in GET /api/v1/payment_methods ---
# Replace with the real accounts. These are placeholders.
INSTAPAY_ADDRESS=yourname@instapay
VODAFONE_CASH_NUMBER=010XXXXXXXX

# --- Push notifications (FCM) ---
# The Firebase SERVICE-ACCOUNT key itself, as ONE line of JSON. Not a path, and not the Android
# google-services.json (that cannot send). Generate: Firebase console > Project settings >
# Service accounts > Generate new private key. Turn the downloaded file into one line with:
#   jq -c . fcm_service_account.json
# and paste the output after the "=". Empty = pushes are logged and skipped.
# WARNING: fcm_service_account.json in this repo is the PRODUCTION project (aghour-app). Pasting it
# here makes local pushes reach real devices. For local work use a key for the dev project.
FCM_SERVICE_ACCOUNT_JSON=

# --- Production only (set in deploy/k8s, not needed locally) ---
# SECRET_KEY_BASE=   # required by production; signs the JWTs
# REVIEWER_MFA_MODE=off  # off | optional | required (authenticator code at dashboard sign-in)
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=          # from bin/rails db:encryption:init; needed once
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=    # REVIEWER_MFA_MODE is not off. Keep an offline copy:
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=  # losing them locks every enrolled reviewer out.
# CRON_SECRET=       # bearer token for GET /internal/cron/subscription_reminders
# ASSUME_SSL=1       # tells Rails the proxy terminated TLS
# FORCE_SSL=1        # redirects plain HTTP to HTTPS

# --- Deploy target for bin/deploy, bin/deploy-once and make deploy ---
# The single-node k3s server (deploy/k8s/README.md).
DEPLOY_HOST=root@192.168.0.12
