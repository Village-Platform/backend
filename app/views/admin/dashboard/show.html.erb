<% content_for :title, "نظرة عامة" %>
<% content_for :subtitle, l(Date.current, format: :long) %>

<div class="quick-actions">
  <%= link_to new_admin_category_path, class: "btn btn-ghost" do %><%= icon(:plus, size: 14) %>تصنيف<% end %>
  <%= link_to new_admin_firm_path, class: "btn btn-ghost" do %><%= icon(:plus, size: 14) %>نشاط<% end %>
  <%= link_to new_admin_article_path, class: "btn btn-ghost" do %><%= icon(:plus, size: 14) %>مقال<% end %>
  <%= link_to new_admin_notification_campaign_path, class: "btn btn-ghost" do %><%= icon(:bell, size: 14) %>حملة إشعار<% end %>
  <%= link_to new_admin_user_path, class: "btn btn-ghost" do %><%= icon(:plus, size: 14) %>تعيين مشرف<% end %>
</div>

<% this_month, last_month = @revenue.last, @revenue[-2] %>
<div class="stats">
  <%= link_to admin_users_path, class: "stat stat-hi" do %>
    <span class="label">إجمالي الأهالي</span>
    <span class="value"><%= @stats[:users] %></span>
  <% end %>
  <%= link_to admin_firms_path, class: "stat" do %>
    <span class="label">الأنشطة المسجلة</span>
    <span class="value"><%= @stats[:firms] %></span>
    <% if @stats[:pending_firms].positive? %>
      <span class="sub"><%= @stats[:pending_firms] %> بانتظار الموافقة</span>
    <% end %>
  <% end %>
  <%= link_to admin_subscriptions_path(status: "active"), class: "stat" do %>
    <span class="label">الاشتراكات الفعالة</span>
    <span class="value"><%= @stats[:current_subscriptions] %></span>
  <% end %>
  <%= link_to admin_subscriptions_path(status: "active"), class: "stat" do %>
    <span class="label">إيرادات هذا الشهر</span>
    <span class="value"><%= egp(this_month.cents) %></span>
    <% if last_month.cents.positive? %>
      <% change = ((this_month.cents - last_month.cents) * 100.0 / last_month.cents).round %>
      <span class="sub <%= "down" if change.negative? %>"><%= change.positive? ? "+" : "" %><%= change %>٪ عن الشهر السابق</span>
    <% end %>
  <% end %>
</div>

<div class="grid grid-2">
  <section class="card">
    <h2 class="mb-3">الإيرادات الشهرية</h2>
    <% peak = @revenue.map(&:cents).max %>
    <div class="chart" role="img" aria-label="الإيرادات الشهرية لآخر <%= @revenue.size %> شهور">
      <% @revenue.each do |month| %>
        <div class="chart-col" title="<%= egp(month.cents) %>">
          <div class="chart-bar <%= "chart-now" if month == this_month %>"
               style="height: <%= peak.positive? ? [ (month.cents * 100.0 / peak).round, 3 ].max : 3 %>%"></div>
          <span class="chart-label"><%= l(month.date, format: "%B") %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="card">
    <h2 class="mb-3">تحتاج إجراءك</h2>
    <%= link_to admin_subscriptions_path(status: "pending"), class: "todo-row" do %>
      <%= icon(:subscriptions, size: 16) %><span class="flex-1">اشتراكات بانتظار المراجعة</span>
      <b class="count"><%= @stats[:pending_subscriptions] %></b>
    <% end %>
    <%= link_to admin_firms_path(status: "pending"), class: "todo-row" do %>
      <%= icon(:firms, size: 16) %><span class="flex-1">أنشطة بانتظار الموافقة</span>
      <b class="count"><%= @stats[:pending_firms] %></b>
    <% end %>
    <%= link_to admin_articles_path(review_status: "pending"), class: "todo-row" do %>
      <%= icon(:articles, size: 16) %><span class="flex-1">مقالات بانتظار الاعتماد</span>
      <b class="count"><%= @stats[:pending_articles] %></b>
    <% end %>
    <%= link_to admin_subscriptions_path(status: "active"), class: "todo-row" do %>
      <%= icon(:clock, size: 16) %><span class="flex-1">اشتراكات تنتهي هذا الأسبوع</span>
      <b class="count"><%= @stats[:expiring_soon] %></b>
    <% end %>
    <% if @stats[:total_deleted].positive? %>
      <div class="mt-4 pt-3 border-t border-line">
        <div class="text-xs text-muted mb-2 font-semibold flex items-center justify-between">
          <span>سلة المحذوفات (قابلة للاستعادة)</span>
          <span class="badge badge-red"><%= @stats[:total_deleted] %></span>
        </div>
        <div class="flex gap-2 flex-wrap text-xs">
          <% if @stats[:deleted_firms].positive? %>
            <%= link_to "أنشطة محذوفة (#{@stats[:deleted_firms]})", admin_firms_path(deleted: "only"), class: "badge badge-gray hover:text-ink" %>
          <% end %>
          <% if @stats[:deleted_users].positive? %>
            <%= link_to "مستخدمون محذوفون (#{@stats[:deleted_users]})", admin_users_path(deleted: "only"), class: "badge badge-gray hover:text-ink" %>
          <% end %>
          <% if @stats[:deleted_articles].positive? %>
            <%= link_to "مقالات محذوفة (#{@stats[:deleted_articles]})", admin_articles_path(deleted: "only"), class: "badge badge-gray hover:text-ink" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>

<div class="grid grid-2">
  <section class="card">
    <h2 class="mb-3">آخر النشاطات</h2>
    <% if @activity.any? %>
      <ul class="feed">
        <% @activity.each do |entry| %>
          <li>
            <%= link_to entry.path, class: "feed-row" do %>
              <span class="feed-icon"><%= icon(entry.icon, size: 14) %></span>
              <span class="flex-1 truncate"><%= entry.text %></span>
              <small>منذ <%= time_ago_in_words(entry.at) %></small>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= empty_state("لا يوجد نشاط بعد") %>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3">الأنشطة حسب التصنيف</h2>
    <% if @firms_by_category.any? %>
      <% busiest = @firms_by_category.first.last %>
      <div class="bars">
        <% @firms_by_category.each do |name, count| %>
          <div class="bar-row">
            <div class="bar-head"><span><%= name %></span><b><%= count %></b></div>
            <div class="bar-track">
              <div class="bar-fill" style="width: <%= (count * 100.0 / busiest).round %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= empty_state("لا توجد أنشطة بعد") %>
    <% end %>
  </section>
</div>

<div class="grid grid-2">
  <section class="card">
    <div class="card-header">
      <h2>طلبات اشتراك تنتظر المراجعة</h2>
      <%= link_to "عرض الكل", admin_subscriptions_path(status: "pending") %>
    </div>
    <% if @pending.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>صاحب الطلب</th><th>الباقة</th><th>المبلغ</th><th>منذ</th></tr></thead>
          <tbody>
            <% @pending.each do |s| %>
              <tr>
                <td><%= link_to s.user.name, admin_subscription_path(s), class: "cell-main" %><span class="cell-sub ltr"><%= s.user.phone %></span></td>
                <td><%= s.subscription_plan.name %></td>
                <td><%= egp(s.amount_cents) %></td>
                <td><%= time_ago_in_words(s.created_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد طلبات جديدة") %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>اشتراكات تنتهي خلال ٧ أيام</h2>
    </div>
    <% if @expiring.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>صاحب النشاط</th><th>الباقة</th><th>ينتهي في</th><th>متبقي</th></tr></thead>
          <tbody>
            <% @expiring.each do |s| %>
              <tr>
                <td><%= link_to s.user.name, admin_user_path(s.user), class: "cell-main" %></td>
                <td><%= s.subscription_plan.name %></td>
                <td><%= fmt_date(s.ends_at) %></td>
                <td><%= badge("#{s.days_left} يوم", s.days_left <= 1 ? "red" : "gold") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد اشتراكات على وشك الانتهاء.") %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>أنشطة تنتظر الاعتماد</h2>
      <%= link_to "عرض الكل", admin_firms_path(status: "pending") %>
    </div>
    <% if @pending_firms.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>النشاط</th><th>التصنيف</th><th>المالك</th><th></th></tr></thead>
          <tbody>
            <% @pending_firms.each do |firm| %>
              <tr>
                <td><%= link_to firm.name, admin_firm_path(firm), class: "cell-main" %></td>
                <td><%= firm.category.name %></td>
                <td><%= firm.owner.name %></td>
                <td><%= button_to "اعتماد", approve_admin_firm_path(firm), method: :patch, class: "btn btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("لا توجد أنشطة جديدة.") %>
    <% end %>
  </section>
</div>
